# MetaRadar Environment Configuration

# Database Connection (Default: SQLite)
DATABASE_URL=sqlite:///./metaradar.db

# Server Configuration
PORT=8000
ENVIRONMENT=development

# Optional AI / LLM API Keys (Leave blank to use built-in zero-dependency deterministic engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Set to true to run deterministic offline engine, or false when using real API key above
USE_MOCK_FALLBACK=true
